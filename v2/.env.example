# Copy to .env and fill in real values. .env is gitignored, never commit it.

# Kaggle CLI credentials (new-scheme API token, KGAT_ prefix).
# Get from kaggle.com/settings -> API. Account must be phone-verified
# to unlock the free GPU + internet.
KAGGLE_API_TOKEN=your-kaggle-api-token-here
KAGGLE_KEY=your-kaggle-api-token-here
KAGGLE_USERNAME=your-kaggle-username-here
